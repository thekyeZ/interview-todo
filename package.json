{
  "name": "interview-todo",
  "version": "2.4.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n \"ANGULAR,JSON-API\" -c \"cyan,yellow\" \"ng serve --port 4200\" \"npm run api\"",
    "start:ui": "ng serve --port 4200",
    "api": "node ./server/start-api.cjs",
    "api:fast": "node ./server/start-api.cjs --immediate --no-delay",
    "db:reset": "node ./server/reset-db.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "concurrently": "^9.1.0",
    "jsdom": "^31.0.0",
    "json-server": "0.17.4",
    "postcss": "^8.5.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
