{
  "name": "interview-todo",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -n \"ANGULAR,JSON-API\" -c \"cyan,yellow\" \"ng serve\" \"npm run api\"",
    "start:ui": "ng serve",
    "api": "json-server --watch db.json --port 3000 --delay 400 --middlewares ./server/middleware.cjs",
    "db:reset": "node ./server/reset-db.cjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@ngrx/operators": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jasmine-core": "~5.4.0",
    "json-server": "0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.0"
  }
}
